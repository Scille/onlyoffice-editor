{
    "compilerOptions": {
        "rootDir": "./src/",
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": true,
        "module": "es6",
        "target": "es2022",
        "allowJs": false,
        "moduleResolution": "bundler",
        "declaration": true,  // Generate .d.ts files
        "declarationDir": "dist"
    },
    "include": ["src"]
}
